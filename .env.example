# Copy to .env beside server.js and fill in. Never commit the real file.
# Values already in the environment win, so `pm2 restart --update-env` overrides.

# --- core ---------------------------------------------------------------
PORT=4090
NODE_ENV=production
PUBLIC_URL=https://ai.saorin.me
# Bind address. Apache proxies to localhost, so loopback keeps the origin
# unreachable from outside (which is what makes the IP headers trustworthy).
HOST=127.0.0.1

# Comma-separated. These emails are seeded as superadmin on boot and re-asserted
# at every login, so admin access survives a wiped database.
SUPERADMIN_EMAILS=you@example.com

# Optional password for those accounts (the username is the email above).
# Re-applied on every boot, so rotating is: edit this line, pm2 restart.
# Clear it and they drop back to one-time codes only. Never commit the real value.
SUPERADMIN_PASSWORD=

# Brute-force throttle on password login (failures only, rolling window).
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_ACCOUNT=8
LOGIN_MAX_PER_IP=20

# HMAC key for OTP + session hashes. Leave unset and one is generated into
# data/.pepper on first boot. Changing it invalidates sessions and pending codes.
# APP_PEPPER=

# --- email OTP (Elastic Email SMTP) -------------------------------------
# The API key is NOT the SMTP password — create a dedicated SMTP credential.
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=AI Generator Template

# --- Telegram OTP (Gateway API) -----------------------------------------
# https://core.telegram.org/gateway/api — billed per code sent.
TG_GATEWAY_TOKEN=
TG_CODE_TTL=300

# --- limits -------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_PER_IDENTIFIER_HOUR=3
OTP_PER_IP_HOUR=5
TG_DAILY_MAX=200
EMAIL_DAILY_MAX=500
PROMPTS_PER_IP_HOUR=240
SESSION_TTL_DAYS=30

# Set to 0 to stop recording prompts from visitors who are not signed in.
CAPTURE_ANONYMOUS=1
